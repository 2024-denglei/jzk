{
  "data": {
    "donor_file": "V2_捐精人主表_3000条.csv",
    "profile_file": "V2_受捐需求Profile_1000条.csv",
    "pair_file": "V2_训练Pair_30万条.csv",
    "label_column": "expert_match_score"
  },
  "rules": {
    "range_scales": {
      "age": 8.0,
      "height_cm": 10.0,
      "weight_kg": 12.0,
      "bmi": 3.5,
      "marriage_age": 8.0
    },
    "default_range_scale": 5.0,
    "single_range_boundary_score": 0.8,
    "education_order": ["高中", "大专", "本科", "硕士", "博士"],
    "education_step_penalty": 0.3333333333333333,
    "skin_color_order": ["偏白", "一般", "偏黑"],
    "skin_color_step_penalty": 0.3333333333333333,
    "keyword_mode": "any",
    "must_match_tolerance": 1e-8
  },
  "model": {
    "context_hidden_dims": [64, 32],
    "dropout": 0.1,
    "scale_min": 0.5,
    "penalty_max": 0.3,
    "bias_limit": 0.15,
    "initial_scale": 1.0,
    "initial_penalty": 0.1
  },
  "training": {
    "seed": 20260824,
    "batch_size": 4096,
    "num_workers": 0,
    "max_epochs": 120,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "huber_delta": 0.03,
    "early_stopping_patience": 12,
    "scheduler_patience": 4,
    "scheduler_factor": 0.5,
    "min_learning_rate": 1e-6,
    "gradient_clip_norm": 5.0,
    "balance_score_bins": true,
    "score_bins": [0.0, 0.2, 0.4, 0.6, 0.8, 1.000001],
    "max_sample_weight": 3.0,
    "use_amp": true
  },
  "evaluation": {
    "top_k": 5,
    "calibration_bins": 10,
    "prediction_batch_size": 16384,
    "make_plots": true
  }
}
