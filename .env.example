# 环境：development / test / production
ENVIRONMENT=development

# LLM API 配置（必填，选择其一）
# OpenAI
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.silra.cn/v1
LLM_MODEL=deepseek-v4-flash

# 或通义千问
# LLM_API_KEY=sk-your-dashscope-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# PostgreSQL 官方库（必填）
DATABASE_URL=postgresql://postgres:jzk_dev_change_me@127.0.0.1:5432/jzk
# DATABASE_ADMIN_URL=postgresql://jzk_admin_api:jzk_admin_dev@127.0.0.1:5432/jzk

# Redis 与手机验证码。生产环境必须使用带认证的私网 Redis，并关闭验证码回传。
REDIS_URL=redis://127.0.0.1:6379/0
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
EXPOSE_TEST_VERIFICATION_CODE=1

# 登录/验证码防爆破（Redis 原子计数）
RATE_LIMIT_PEPPER=change-me-in-production
USER_LOGIN_LIMIT=5
USER_LOGIN_WINDOW_SECONDS=600
ADMIN_LOGIN_LIMIT=5
ADMIN_LOGIN_WINDOW_SECONDS=900
CODE_PHONE_HOURLY_LIMIT=5
CODE_PHONE_DAILY_LIMIT=10
CODE_IP_HOURLY_LIMIT=20
CODE_VERIFY_IP_HOURLY_LIMIT=30

# 首次启动引导管理员（生产环境必须修改用户名和至少 12 位密码）
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Admin@ChangeMe1

# 历史 Excel 仅用于导入/联调，非运行时数据源
# DATA_FILE_PATH=E:\jzk\人造精子匹配数据.xlsx

# 服务配置
HOST=0.0.0.0
PORT=8000
# 生产环境必须替换为至少 32 字节的随机值，例如：openssl rand -hex 32
JWT_SECRET=change-me-in-production

# 对话匹配服务。留空 = 本进程 POST /api/match
# MATCH_API_URL=http://127.0.0.1:8010/api/match

# V2 排序模型（默认 models/best_model_v2.pt，CPU）
# V2_CHECKPOINT_PATH=
# V2_CONFIG_PATH=
# V2_FORCE_CPU=1
