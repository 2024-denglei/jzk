# 环境：development / test / production
ENVIRONMENT=development

# LLM API 配置（必填，选择其一）
# OpenAI
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.silra.cn/v1
LLM_MODEL=deepseek-v4-flash

# 或通义千问
# LLM_API_KEY=sk-your-dashscope-key
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

# PostgreSQL 官方库（必填）。5433 是 compose 对宿主机发布的端口，容器内部仍是 5432。
DATABASE_URL=postgresql://postgres:jzk_dev_change_me@127.0.0.1:5433/jzk
# DATABASE_ADMIN_URL=postgresql://jzk_admin_api:jzk_admin_dev@127.0.0.1:5433/jzk
# DATABASE_MIGRATOR_URL=postgresql://jzk_migrator:jzk_migrator_dev@127.0.0.1:5433/jzk
PG_POOL_MIN_SIZE=1
PG_POOL_MAX_SIZE=10
PG_POOL_TIMEOUT_SECONDS=5

# Redis 与手机验证码。生产环境必须使用带认证的私网 Redis，并关闭验证码回传。
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_CODE_COOLDOWN_SECONDS=60
VERIFICATION_CODE_MAX_ATTEMPTS=5
EXPOSE_TEST_VERIFICATION_CODE=1

# 登录/验证码防爆破（Redis 原子计数）
RATE_LIMIT_PEPPER=change-me-in-production
USER_LOGIN_LIMIT=5
USER_LOGIN_WINDOW_SECONDS=600
ADMIN_LOGIN_LIMIT=5
ADMIN_LOGIN_WINDOW_SECONDS=900
CODE_PHONE_HOURLY_LIMIT=5
CODE_PHONE_DAILY_LIMIT=10
CODE_IP_HOURLY_LIMIT=20
CODE_VERIFY_IP_HOURLY_LIMIT=30

# 首次启动引导管理员（生产环境必须修改用户名和至少 12 位密码）
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=Admin@ChangeMe1

# 历史 Excel 仅用于一次性导入/联调，非运行时数据源，改由
# scripts/seed_donors_from_excel.py --file 显式传入

# 服务配置
HOST=0.0.0.0
PORT=8010
# 生产环境必须替换为至少 32 字节的随机值，例如：openssl rand -hex 32
JWT_SECRET=change-me-in-production
JWT_ISSUER=jzk-api
JWT_AUDIENCE=jzk-web
ACCESS_TOKEN_EXPIRE_MINUTES=30
USER_REFRESH_TOKEN_DAYS=30
ADMIN_REFRESH_TOKEN_HOURS=8
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
CHAT_GENERATION_WORKER_ENABLED=0
# 非空时 Worker 只领取这些用户的任务。
CHAT_GENERATION_WORKER_USER_IDS=
CHAT_OUTBOX_WORKER_ENABLED=0
CHAT_OUTBOX_LEASE_SECONDS=60
CHAT_OUTBOX_MAX_ATTEMPTS=10
CHAT_OUTBOX_RETRY_BASE_SECONDS=2
CHAT_OUTBOX_RETRY_MAX_SECONDS=300
CHAT_GENERATION_LEASE_SECONDS=60
CHAT_GENERATION_HEARTBEAT_SECONDS=15
CHAT_GENERATION_MAX_ATTEMPTS=3
CHAT_GENERATION_CHECKPOINT_INTERVAL_SECONDS=2
CHAT_GENERATION_CHECKPOINT_CHARS=256
CHAT_GENERATION_STREAM_TTL_SECONDS=3600
CHAT_MESSAGE_PAGE_SIZE_DEFAULT=50
CHAT_MESSAGE_PAGE_SIZE_MAX=100
CHAT_LIST_PAGE_SIZE_DEFAULT=20
CHAT_LIST_PAGE_SIZE_MAX=100
CHAT_CURSOR_TTL_SECONDS=86400
CHAT_BRANCH_MAX_PER_CHAT=200
CHAT_MESSAGE_MAX_PER_CHAT=10000
CHAT_MESSAGE_MAX_CHARS=20000
CHAT_MATCH_SNAPSHOT_MAX_CANDIDATES=20000

MAX_REQUEST_BODY_BYTES=25000000
MAX_JSON_BODY_BYTES=1000000
MAX_AUDIO_UPLOAD_BYTES=20000000
MAX_EXCEL_UPLOAD_BYTES=10000000
MATCH_RESULT_PAGING_ENABLED=1
MATCH_SNAPSHOT_ENABLED=1
MATCH_RESULT_MAX_CANDIDATES=20000
MATCH_RESULT_PAGE_SIZE_DEFAULT=20
MATCH_RESULT_PAGE_SIZE_MAX=50
MATCH_SNAPSHOT_RETENTION_DAYS=180
MATCH_CURSOR_TTL_SECONDS=86400
MATCH_MODEL_VERSION=v32-v4-best-mae
# 匹配编排仍在主应用：must 查 PostgreSQL 后调用独立评分服务
MATCH_SCORING_BACKEND=http
MATCH_SCORER_URL=http://127.0.0.1:8020
MATCH_SCORER_CONTRACT_VERSION=1
MATCH_SCORER_TIMEOUT_SECONDS=15
MATCH_SCORER_MAX_CANDIDATES=20000
# 鉴权用的共享密钥见下方 SCORER_TOKEN，两端共用一个变量名

# 对话匹配服务。留空 = 本进程 POST /api/match
# MATCH_API_URL=http://127.0.0.1:8010/api/match

# V2 排序模型（默认 models/best_model_v2.pt，CPU）
# V2_CHECKPOINT_PATH=
# V2_CONFIG_PATH=
# V2_FORCE_CPU=1

# 独立评分服务进程。SCORER_TOKEN 由主应用和评分服务共读，天然不会写歪；生产环境
# 必须替换为至少 32 字节的随机值。
# SCORER_MODEL_PATH=/absolute/path/to/models/best_mae_model_v4.pt
SCORER_MODEL_VERSION=v32-v4-best-mae
SCORER_FORCE_CPU=1
SCORER_CANDIDATE_POOL=5000
SCORER_MAX_CANDIDATES=20000
SCORER_MAX_REQUEST_BYTES=25000000
# 候选池较大时可适当提高主应用等待评分服务的超时（秒）
# MATCH_SCORER_TIMEOUT_SECONDS=60
SCORER_TOKEN=dev-match-scorer-token-change-me
# SCORER_EXPECTED_CHECKPOINT_SHA256=6ffa19eb2c377830e43dd2942bb3cfdce4fe6d62d7ff8a10a285d26cd7988944
SCORER_EXPECTED_MODEL_NAME=sperm-match-v4-tender-multitask
SCORER_EXPECTED_CHECKPOINT_ROLE=best_mae
SCORER_RANK_SOURCE=ranking_score
