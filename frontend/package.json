{
  "name": "jzk-frontend",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["shared", "client", "admin"],
  "scripts": {
    "dev:client": "npm run dev -w @jzk/client",
    "dev:admin": "npm run dev -w @jzk/admin",
    "build": "npm run build -w @jzk/client && npm run build -w @jzk/admin",
    "test": "npm run test -w @jzk/client && npm run test -w @jzk/admin",
    "lint": "npx oxlint client/src admin/src",
    "typecheck": "tsc -b",
    "generate:api": "openapi-typescript shared/openapi.json -o shared/openapi.d.ts"
  },
  "devDependencies": {
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2"
  }
}
